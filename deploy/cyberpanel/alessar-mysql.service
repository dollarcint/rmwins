[Unit]
Description=Alessar isolated MariaDB on private port 3307
After=network.target

[Service]
Type=simple
User=apial8464
Group=apial8464
ExecStart=/usr/sbin/mariadbd --defaults-file=/home/api.alessarsolutions.in/alessarsolutions/deploy/cyberpanel/mariadb-3307.cnf
Restart=always
RestartSec=5
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=false

[Install]
WantedBy=multi-user.target
