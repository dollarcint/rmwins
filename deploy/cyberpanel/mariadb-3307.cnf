[client]
port=3307
socket=/home/api.alessarsolutions.in/tmp/alessar-mysql.sock

[mysqld]
bind-address=127.0.0.1
port=3307
socket=/home/api.alessarsolutions.in/tmp/alessar-mysql.sock
pid-file=/home/api.alessarsolutions.in/tmp/alessar-mysql.pid
datadir=/home/api.alessarsolutions.in/mysql-data
tmpdir=/home/api.alessarsolutions.in/tmp
log-error=/home/api.alessarsolutions.in/app_logs/alessar-mysql.log

skip-name-resolve
skip-symbolic-links
local-infile=0
character-set-server=utf8mb4
collation-server=utf8mb4_unicode_ci
max-connections=100
innodb-buffer-pool-size=256M
performance-schema=OFF

[mariadb-install-db]
datadir=/home/api.alessarsolutions.in/mysql-data
socket=/home/api.alessarsolutions.in/tmp/alessar-mysql.sock
