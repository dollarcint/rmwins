[Unit]
Description=RMWins Gunicorn, Celery and private Redis processes
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=wwwrm1759
Group=wwwrm1759
WorkingDirectory=/home/www.rmwinsights.com/rmwins/backend
Environment=HOME=/home/www.rmwinsights.com
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/home/www.rmwinsights.com/.config/rmwins/backend.env
ExecStart=/home/www.rmwinsights.com/rmwins/backend/.venv/bin/supervisord -n -c /home/www.rmwinsights.com/rmwins/deploy/rmwins-cyberpanel/supervisord.conf
ExecReload=/home/www.rmwinsights.com/rmwins/backend/.venv/bin/supervisorctl -c /home/www.rmwinsights.com/rmwins/deploy/rmwins-cyberpanel/supervisord.conf reload
Restart=always
RestartSec=5
TimeoutStopSec=90
KillMode=mixed
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadOnlyPaths=/home/www.rmwinsights.com/.config/rmwins
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
